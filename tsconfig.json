{
    "compilerOptions": {
        /* -------------------------------------------------
       Cible & runtime
    ------------------------------------------------- */
        "target": "ES2018",
        "lib": ["DOM", "ES2018"],
        "module": "CommonJS",
        "moduleResolution": "Node",

        /* -------------------------------------------------
       Sécurité & qualité
    ------------------------------------------------- */
        "strict": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "useDefineForClassFields": false,

        /* -------------------------------------------------
       Compatibilité Obsidian
    ------------------------------------------------- */
        "downlevelIteration": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,

        /* -------------------------------------------------
       Build plugin
    ------------------------------------------------- */
        "outDir": "dist",
        "sourceMap": true,
        "inlineSources": true,
        "declaration": false,

        /* -------------------------------------------------
       Perf & DX
    ------------------------------------------------- */
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },

    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
